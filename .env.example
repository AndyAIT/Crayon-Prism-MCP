PRISM_TOKEN_URL=https://identity.prismportal.online/connect/token
PRISM_CLIENT_ID=your_client_id
PRISM_CLIENT_SECRET=your_client_secret
PRISM_API_BASE_URL=https://api.prismportal.online
# Required when MCP_TRANSPORT=streamable-http; clients send "Authorization: Bearer <token>"
MCP_AUTH_TOKEN=generate_a_long_random_value
# Set to true to allow quantity-change tools to act (otherwise they only dry-run)
MCP_ALLOW_WRITES=false
